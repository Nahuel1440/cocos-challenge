{
  "name": "cocos-challenge",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": "^22"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.config.e2e.mts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v",
    "db:baseline": "prisma migrate resolve --applied 0_init",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@nestjs-cls/transactional": "4.0.2",
    "@nestjs-cls/transactional-adapter-prisma": "2.0.2",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "nestjs-cls": "7.0.2",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.8",
    "@swc/core": "^1.16.21",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "prisma": "7.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
